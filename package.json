{
  "name": "ai-image-detection---forensics-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "build": "node node_modules/vite/bin/vite.js build",
    "lint": "node node_modules/oxlint/dist/index.js",
    "preview": "node node_modules/vite/bin/vite.js preview",
    "server": "py -3.13 -m uvicorn backend.main:app --host 127.0.0.1 --port 8000 --reload",
    "server:prod": "py -3.13 -m uvicorn backend.main:app --host 127.0.0.1 --port 8000",
    "fullstack": "node node_modules/concurrently/dist/bin/index.js -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run server\" \"npm run dev\"",
    "dev:all": "npm run fullstack",
    "start": "npm run build && npm run server:prod"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^13.4.0",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  }
}
